{
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "jquery",
      "bootstrap",
    ],
    "target": "es2021",
    "lib": ["dom", "es2021"],
    "skipLibCheck": true,
    "sourceMap": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "jsx": "react",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "../declarations",
    "allowUmdGlobalAccess": true
  },
  "compileOnSave": false
}
